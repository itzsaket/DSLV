QT       += core gui
QT += widgets core gui
QT += serialport
QT += opengl
LIBS += -lOpenGL32

RESOURCES += \
    shaders/vertex.glsl \
    shaders/fragment.glsl



greaterThan(QT_MAJOR_VERSION, 4): QT += widgets

CONFIG += c++17

